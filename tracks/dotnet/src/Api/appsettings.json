{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Dojo": {
    "Catalog": {
      "Title": "Dojo Catalog",
      "PageSize": 25,
      "Currency": "EUR"
    },
    "Reports": {
      "MaxRows": 500
    },
    "Feeds": {
      "primary": {
        "Url": "https://primary.example/feed",
        "TimeoutSeconds": 5
      },
      "fallback": {
        "Url": "https://fallback.example/feed",
        "TimeoutSeconds": 30
      }
    },
    "Mailer": {
      "FromAddress": "dojo@example.com"
    }
  }
}
