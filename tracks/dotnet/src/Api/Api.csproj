<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Learner code lives here. Warnings teach; they must never block a
         build, or a half-finished exercise would fail with a compiler error
         instead of the gate's teaching message. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- CS9113: an unimplemented middleware stub never reads its `next`. -->
    <NoWarn>$(NoWarn);CS0168;CS0219;CS1998;CS9113</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
  </ItemGroup>

</Project>
